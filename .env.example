# ============================================================================
# SmartChain Frontend — biến môi trường mẫu
# Copy sang .env và điều chỉnh theo môi trường của bạn:
#   cp .env.example .env
# ============================================================================

# Port chạy Vite dev server (mặc định 2324)
VITE_PORT=2324

# Địa chỉ Backend API để Vite proxy /api/* sang
# Dev local: http://localhost:3000
# Staging  : https://api-staging.smartchain.vn
VITE_API_TARGET=http://localhost:3000

# API base path giữ /api để khớp refresh cookie path /api/v1/auth.
# Production: reverse proxy /api tới BE; cross-origin chỉ dùng cùng site và CORS credentials.
VITE_API_URL=/api

# BE phải đặt AUTH_WEB_ORIGIN đúng origin FE, ví dụ http://localhost:2324.
# Local HTTP: BE NODE_ENV=development; production cần HTTPS cho Secure cookie.
