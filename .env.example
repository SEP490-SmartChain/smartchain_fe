# ============================================================================
# orca Frontend — biến môi trường mẫu
# Copy sang .env và điều chỉnh theo môi trường của bạn:
#   cp .env.example .env
# ============================================================================

# Port chạy Vite dev server (mặc định 2324)
VITE_PORT=2324

# Địa chỉ Backend API để Vite proxy /api/* sang
# Dev local: http://localhost:3000
# Staging  : https://api-staging.orca.vn
VITE_API_TARGET=http://localhost:3000

# API base path giữ /api để khớp refresh cookie path /api/v1/auth.
# Production: reverse proxy /api tới BE; cross-origin chỉ dùng cùng site và CORS credentials.
VITE_API_URL=/api

# Địa chỉ công khai của orca API (URL HTTPS tuyệt đối, gồm /api) mà hệ thống bên
# ngoài như ERP/POS/website gọi tới; hiển thị ở Cài đặt → API Keys → Thông tin kết nối.
# Chỉ nhận HTTPS tới tên miền công khai: localhost, IP nội bộ hoặc http:// bị bỏ qua vì ERP
# của doanh nghiệp không gọi tới được và API key không được đi qua HTTP thường.
# Để trống ở dev local; production: https://<orca_API_HOST>/api
VITE_PUBLIC_API_URL=

# BE phải đặt AUTH_WEB_ORIGIN đúng origin FE, ví dụ http://localhost:2324.
# Local HTTP: BE NODE_ENV=development; production cần HTTPS cho Secure cookie.

# Bản đồ chọn vị trí kho (tùy chọn, HERE Maps): tạo khóa API trên platform.here.com và
# GIỚI HẠN theo tên miền (http://localhost:2324 + tên miền thật). Để trống = không hiện bản đồ,
# nhập tọa độ thủ công. Đặt khóa trong .env, không commit.
VITE_HERE_API_KEY=

# SS-990: FE chỉ gọi ORCA API; SIGNNOW_ACCESS_TOKEN / WEBHOOK_SECRET thuộc BE và worker.
# Mở /settings/contract bằng tài khoản Seller Owner để chọn gói và ký trong ORCA.
# Setup team: xem orca_be/docs/SS-990-LOCAL-SETUP.md.
# Nếu chạy instance test riêng ở 2326/3006, đổi các giá trị phía trên thành:
#   VITE_PORT=2326
#   VITE_API_TARGET=http://localhost:3006
#   BE AUTH_WEB_ORIGIN=http://localhost:2326
# package.json dev cố định --port 2324; để đổi port dùng npm run dev -- --port 2326.
