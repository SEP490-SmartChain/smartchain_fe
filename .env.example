# ============================================================================
# SmartChain Frontend — biến môi trường mẫu
# Copy sang .env và điều chỉnh theo môi trường của bạn:
#   cp .env.example .env
# ============================================================================

# Port chạy Vite dev server (mặc định 2324)
VITE_PORT=2324

# Địa chỉ Backend API để Vite proxy /api/* sang
# Dev local: http://localhost:3000
# Staging  : https://api-staging.smartchain.vn
VITE_API_TARGET=http://localhost:3000
